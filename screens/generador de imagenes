<!DOCTYPE html>
<html class="dark" lang="es">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>FLUX_AI — Generador</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg: #131314;
      --surface: #1c1b1c;
      --surface2: #2a2a2b;
      --border: #353436;
      --primary: #bc13fe;
      --primary-dim: #ebb2ff;
      --text: #e5e2e3;
      --text-dim: #d4c0d7;
      --cyan: #00e5ff;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Space Grotesk', sans-serif;
      min-height: 100vh;
    }

    /* NAVBAR */
    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid var(--border);
      background: var(--surface);
    }
    .nav-logo {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--primary);
      letter-spacing: 2px;
    }
    .nav-back {
      color: var(--text-dim);
      text-decoration: none;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .nav-back:hover { color: var(--primary-dim); }

    /* MAIN */
    main {
      max-width: 700px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    h1 {
      font-size: 1.6rem;
      font-weight: 700;
      margin-bottom: 0.3rem;
    }
    h1 span { color: var(--primary); }
    .subtitle {
      color: var(--text-dim);
      font-size: 0.9rem;
      margin-bottom: 2rem;
    }

    /* PROMPT BOX */
    .prompt-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.2rem;
      margin-bottom: 1rem;
    }
    .prompt-box label {
      display: block;
      font-size: 0.75rem;
      letter-spacing: 1px;
      color: var(--cyan);
      margin-bottom: 0.6rem;
      text-transform: uppercase;
    }
    textarea {
      width: 100%;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.95rem;
      padding: 0.8rem 1rem;
      resize: none;
      height: 100px;
      outline: none;
      transition: border 0.2s;
    }
    textarea:focus { border-color: var(--primary); }

    /* STYLE CHIPS */
    .chips-label {
      font-size: 0.75rem;
      letter-spacing: 1px;
      color: var(--cyan);
      text-transform: uppercase;
      margin-bottom: 0.6rem;
      margin-top: 1rem;
      display: block;
    }
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.2rem;
    }
    .chip {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 0.35rem 0.9rem;
      font-size: 0.8rem;
      color: var(--text-dim);
      cursor: pointer;
      transition: all 0.2s;
      user-select: none;
    }
    .chip:hover, .chip.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }

    /* GENERATE BUTTON */
    .btn-generate {
      width: 100%;
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 12px;
      padding: 1rem;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 1px;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.1s;
    }
    .btn-generate:hover { opacity: 0.9; }
    .btn-generate:active { transform: scale(0.98); }
    .btn-generate:disabled { opacity: 0.5; cursor: not-allowed; }

    /* RESULT */
    .result-box {
      margin-top: 1.5rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      display: none;
    }
    .result-box.visible { display: block; }

    .result-header {
      padding: 0.8rem 1.2rem;
      border-bottom: 1px solid var(--border);
      font-size: 0.75rem;
      letter-spacing: 1px;
      color: var(--cyan);
      text-transform: uppercase;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .btn-download {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text-dim);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.75rem;
      padding: 0.3rem 0.8rem;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
    }
    .btn-download:hover { border-color: var(--primary); color: var(--primary-dim); }

    .result-img-wrap {
      position: relative;
      min-height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--surface2);
    }
    #result-img {
      width: 100%;
      display: block;
      border-radius: 0;
    }

    /* LOADING */
    .loading {
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 2rem;
      color: var(--text-dim);
      font-size: 0.9rem;
    }
    .loading.visible { display: flex; }
    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid var(--border);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ERROR */
    .error-box {
      display: none;
      background: #2a0a0a;
      border: 1px solid #690005;
      border-radius: 12px;
      padding: 1rem 1.2rem;
      color: #ffb4ab;
      font-size: 0.875rem;
      margin-top: 1rem;
    }
    .error-box.visible { display: block; }

    /* EXAMPLES */
    .examples {
      margin-top: 1.5rem;
    }
    .examples-label {
      font-size: 0.75rem;
      letter-spacing: 1px;
      color: var(--text-dim);
      text-transform: uppercase;
      margin-bottom: 0.8rem;
      display: block;
    }
    .example-btns {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .example-btn {
      background: transparent;
      border: 1px dashed var(--border);
      border-radius: 8px;
      color: var(--text-dim);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.78rem;
      padding: 0.4rem 0.8rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    .example-btn:hover {
      border-color: var(--primary-dim);
      color: var(--primary-dim);
    }
  </style>
</head>
<body>

<nav>
  <div class="nav-logo">✦ FLUX_AI</div>
  <a class="nav-back" href="../../index.html">← Menú</a>
</nav>

<main>
  <h1>Generador de <span>Imágenes</span></h1>
  <p class="subtitle">Describe lo que quieres crear y la IA lo generará por ti</p>

  <div class="prompt-box">
    <label>Descripción de la imagen</label>
    <textarea id="prompt" placeholder="Ej: Un paisaje cyberpunk con neón morado, lluvia y rascacielos futuristas..."></textarea>

    <span class="chips-label">Estilo</span>
    <div class="chips">
      <div class="chip active" data-style="">Ninguno</div>
      <div class="chip" data-style="cyberpunk style, neon lights">Cyberpunk</div>
      <div class="chip" data-style="anime style, detailed">Anime</div>
      <div class="chip" data-style="photorealistic, 4k, detailed">Realista</div>
      <div class="chip" data-style="fantasy art, magical, epic">Fantasía</div>
      <div class="chip" data-style="watercolor painting, soft">Acuarela</div>
      <div class="chip" data-style="minimalist, clean, simple">Minimalista</div>
    </div>
  </div>

  <button class="btn-generate" id="btn-gen" onclick="generateImage()">⚡ GENERAR IMAGEN</button>

  <div class="error-box" id="error-box"></div>

  <div class="result-box" id="result-box">
    <div class="result-header">
      <span>IMAGEN GENERADA</span>
      <a class="btn-download" id="btn-download" download="flux_ai_image.png">⬇ Descargar</a>
    </div>
    <div class="result-img-wrap">
      <div class="loading" id="loading">
        <div class="spinner"></div>
        <span id="loading-text">Generando tu imagen... puede tomar 20-40 segundos</span>
      </div>
      <img id="result-img" alt="Imagen generada" style="display:none"/>
    </div>
  </div>

  <div class="examples">
    <span class="examples-label">💡 Ideas rápidas</span>
    <div class="example-btns">
      <button class="example-btn" onclick="setPrompt('Un gato astronauta flotando en el espacio con galaxias de colores')">🐱 Gato astronauta</button>
      <button class="example-btn" onclick="setPrompt('Ciudad futurista al atardecer con coches voladores y luces de neón')">🌆 Ciudad futurista</button>
      <button class="example-btn" onclick="setPrompt('Bosque mágico con hongos luminosos y hadas volando')">🍄 Bosque mágico</button>
      <button class="example-btn" onclick="setPrompt('Dragón de cristal en una montaña nevada bajo la aurora boreal')">🐉 Dragón de cristal</button>
      <button class="example-btn" onclick="setPrompt('Retrato de una mujer robot con ojos de circuito y cabello dorado')">🤖 Mujer robot</button>
    </div>
  </div>
</main>

<script>
  // Chips de estilo
  let selectedStyle = '';
  document.querySelectorAll('.chip').forEach(chip => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      selectedStyle = chip.dataset.style;
    });
  });

  function setPrompt(text) {
    document.getElementById('prompt').value = text;
  }

  async function generateImage() {
    const promptText = document.getElementById('prompt').value.trim();
    if (!promptText) {
      showError('Por favor escribe una descripción para generar la imagen.');
      return;
    }

    const fullPrompt = selectedStyle ? `${promptText}, ${selectedStyle}` : promptText;

    // UI state
    document.getElementById('btn-gen').disabled = true;
    document.getElementById('btn-gen').textContent = '⏳ Generando...';
    document.getElementById('error-box').classList.remove('visible');
    document.getElementById('result-box').classList.add('visible');
    document.getElementById('loading').classList.add('visible');
    document.getElementById('result-img').style.display = 'none';

    // Modelos públicos de Hugging Face (sin API key)
    const models = [
      'https://api-inference.huggingface.co/models/stabilityai/stable-diffusion-2-1',
      'https://api-inference.huggingface.co/models/runwayml/stable-diffusion-v1-5',
      'https://api-inference.huggingface.co/models/CompVis/stable-diffusion-v1-4'
    ];

    let imageBlob = null;
    let lastError = '';

    for (let i = 0; i < models.length; i++) {
      document.getElementById('loading-text').textContent =
        `Intentando modelo ${i + 1} de ${models.length}... puede tomar 20-40 segundos`;
      try {
        const response = await fetch(models[i], {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ inputs: fullPrompt })
        });

        if (response.ok) {
          const contentType = response.headers.get('content-type');
          if (contentType && contentType.includes('image')) {
            imageBlob = await response.blob();
            break;
          }
        } else if (response.status === 503) {
          // Modelo cargando, esperar y reintentar
          document.getElementById('loading-text').textContent =
            `Modelo cargando, esperando... (${i + 1}/${models.length})`;
          await new Promise(r => setTimeout(r, 8000));
          const retry = await fetch(models[i], {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ inputs: fullPrompt })
          });
          if (retry.ok) {
            imageBlob = await retry.blob();
            break;
          }
        }
        lastError = `Error ${response.status}`;
      } catch (e) {
        lastError = e.message;
      }
    }

    // Reset button
    document.getElementById('btn-gen').disabled = false;
    document.getElementById('btn-gen').textContent = '⚡ GENERAR IMAGEN';
    document.getElementById('loading').classList.remove('visible');

    if (imageBlob) {
      const url = URL.createObjectURL(imageBlob);
      const img = document.getElementById('result-img');
      img.src = url;
      img.style.display = 'block';
      document.getElementById('btn-download').href = url;
    } else {
      document.getElementById('result-box').classList.remove('visible');
      showError('No se pudo generar la imagen en este momento. Los servidores gratuitos de Hugging Face pueden estar ocupados. Intenta de nuevo en unos minutos.');
    }
  }

  function showError(msg) {
    const box = document.getElementById('error-box');
    box.textContent = '⚠️ ' + msg;
    box.classList.add('visible');
  }
</script>
</body>
</html>
