<div class="relative">
<input class="w-full bg-surface-container-low border border-outline-variant focus:border-secondary-container focus:ring-1 focus:ring-secondary-container transition-all duration-300 rounded-lg px-4 py-3 text-on-surface placeholder:text-stone-600 outline-none" placeholder="neural@link.io" type="email"/>
</div>
</div>
