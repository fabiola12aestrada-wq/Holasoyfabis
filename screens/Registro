<span class="text-[10px] uppercase font-bold tracking-widest text-secondary-fixed-dim">Entropy Strength</span>
<span class="text-[10px] text-secondary-fixed-dim">78%</span>
</div>
<div class="h-1 w-full bg-white/5 rounded-full overflow-hidden">
<div class="h-full w-4/5 pulse-cyan neon-glow-cyan"></div>
</div>
</div>
</div>
<!-- Action Buttons -->
